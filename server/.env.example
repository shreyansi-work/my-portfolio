# Copy this file to .env for local development. Never commit .env.
# On Render, set these in the dashboard (Environment tab) instead.

# MongoDB Atlas connection string (create a database user with read/write on one database only)
# Example shape: mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# Port for local development (Render sets PORT automatically)
PORT=5000

# Optional: comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the site and API are served from the same service (the default setup).
ALLOWED_ORIGINS=

# Optional: how many contact messages one IP may send per 15 minutes (default 5)
CONTACT_RATE_LIMIT_MAX=5
